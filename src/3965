package main

func finishTime(n int, edges [][]int, baseTime []int) int64 {

	tree := make([][]int, n)
	for i := 0; i < len(tree); i++ {
		tree[i] = make([]int, 0)
	}
	for i := 0; i < len(edges); i++ {
		tree[edges[i][0]] = append(tree[edges[i][0]], edges[i][1])
	}
	cost := make([]int64, n)
	for i := n - 1; i >= 0; i-- {

		if len(tree[i]) == 0 {
			cost[i] = int64(baseTime[i])
		} else if len(tree[i]) == 1 {
			cost[i] = int64(baseTime[i]) + cost[tree[i][0]]
		} else {
			smallest := cost[tree[i][0]]
			biggest := cost[tree[i][0]]
			for j := 0; j < len(tree[i]); j++ {
				smallest = min(smallest, cost[tree[i][j]])
				biggest = max(biggest, cost[tree[i][j]])
			}
			ownDuration := (biggest - smallest) + int64(baseTime[i])
			cost[i] = ownDuration + biggest
		}
	}
	return cost[0]
}

func abs2(n int64) int64 {
	if n < 0 {
		return -n
	}
	return n
}
